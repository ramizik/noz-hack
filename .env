# Brand (rename the product without touching code)
NEXT_PUBLIC_BRAND_NAME=team1
NEXT_PUBLIC_BRAND_TAGLINE=The always-on incident commander.
NEXT_PUBLIC_BRAND_DESCRIPTION=An always-on AI security agent that monitors alerts, grounds decisions in Nia-indexed runbooks, and remembers everything across sessions via Tensorlake.

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Agent runtime (Tensorlake) — durable memory + sandbox execution + scheduling
TENSORLAKE_API_KEY=
TENSORLAKE_PROJECT_ID=

# Knowledge layer (Nia MCP) — runbooks, postmortems, procedures
NIA_API_KEY=
NIA_INDEX_ID=

# Demo: replay pre-seeded alerts into the webhook
MOCK_ALERT_WEBHOOK_URL=http://localhost:3000/api/webhooks/guardduty
MOCK_ALERT_INTERVAL_SECONDS=60
DEMO_SEED_DIR=demo/seed/alerts
